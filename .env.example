# ⚠️  ATENÇÃO: NUNCA comite este arquivo com valores reais.
#     O .env está no .gitignore. Se você encontrou um .env commitado,
#     rotacione TODOS os segredos IMEDIATAMENTE.
#     Gere segredos com: openssl rand -hex 48 (JWT) / openssl rand -hex 32 (webhook)

# PostgreSQL
POSTGRES_USER=plataforma
POSTGRES_PASSWORD=plataforma_dev
POSTGRES_DB=plataforma
# POSTGRES_PORT=5432

# Redis
# REDIS_PORT=6379

# API
PORT=3000
CORS_ORIGIN=http://localhost:3001
DATABASE_URL=postgresql://plataforma:plataforma_dev@localhost:5432/plataforma
REDIS_URL=redis://localhost:6379
# API_PORT=3000
# BRAND_NAME=Minha Escola

# Auth (JWT) — OBRIGATÓRIOS (a API recusa subir sem eles ou com placeholders)
# Gere com: openssl rand -hex 48
# JWT_ACCESS_SECRET=<gere um segredo de 48 bytes>
# JWT_REFRESH_SECRET=<gere um segredo de 48 bytes>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Throttle
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Web
NEXT_PUBLIC_API_URL=http://localhost:3000
# WEB_PORT=3001
# NEXT_PUBLIC_BRAND_NAME=Minha Escola
# NEXT_PUBLIC_BRAND_LOGO_URL=https://...

# Gitea
GITEA_URL=http://localhost:3030
# GITEA_TOKEN=<copie o valor impresso por pnpm seed:gitea>
# GITEA_WEBHOOK_SECRET=<gere com: openssl rand -hex 32>
GITEA_ENABLED=true
# GITEA_HTTP_PORT=3030
# GITEA_SSH_PORT=2222

# Sandbox (Piston) — usado pela API quando roda fora do compose
# PISTON_URL=http://localhost:2000
# PISTON_TIMEOUT_MS=30000
# PISTON_MAX_OUTPUT_CHARS=4096

# Seed do Gitea (usado por scripts/seed-gitea.mjs)
# ⚠️  NUNCA use estas senhas em produção ou em ambientes expostos.
GITEA_ADMIN_USER=admin
GITEA_ADMIN_PASSWORD=admin12345
GITEA_ADMIN_EMAIL=admin@plataforma.local
GITEA_ORG=plataforma
GITEA_BOT_USER=plataforma-bot
GITEA_BOT_PASSWORD=bot12345
GITEA_BOT_EMAIL=plataforma-bot@plataforma.local

# Prisma (migrations)
SHADOW_DATABASE_URL=postgresql://plataforma:plataforma_dev@localhost:5432/plataforma_shadow

# AI Tutor (opcional — sem chave, usa engine heurístico offline)
# AI_API_KEY=<sua chave OpenAI/compatible>
# AI_API_URL=https://api.openai.com/v1/chat/completions
# AI_MODEL=gpt-4o-mini
