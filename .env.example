# ⚠️  ATENÇÃO: NUNCA comite este arquivo com valores reais.
#     O .env está no .gitignore. Se você encontrou um .env commitado,
#     rotacione TODOS os segredos IMEDIATAMENTE.
#     Gere segredos com: openssl rand -hex 48 (JWT) / openssl rand -hex 32 (webhook)

# PostgreSQL
POSTGRES_USER=plataforma
POSTGRES_PASSWORD=plataforma_dev
POSTGRES_DB=plataforma
# POSTGRES_PORT=5432

# Redis
# REDIS_PORT=6379

# API
PORT=3000
CORS_ORIGIN=http://localhost:3001
DATABASE_URL=postgresql://plataforma:plataforma_dev@localhost:5432/plataforma
REDIS_URL=redis://localhost:6379
# API_PORT=3000
# BRAND_NAME=Minha Escola

# Auth (JWT) — OBRIGATÓRIOS (a API recusa subir sem eles ou com placeholders)
# Gere com: openssl rand -hex 48
# JWT_ACCESS_SECRET=<gere um segredo de 48 bytes>
# JWT_REFRESH_SECRET=<gere um segredo de 48 bytes>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# COOKIE_SAME_SITE=lax
#   Mesma origem (default 'lax'): dev em localhost, web e API no mesmo site.
#   Defina 'none' SOMENTE quando web e API estão em domínios diferentes em
#   produção — nesse caso o cookie passa a ser SameSite=None + Secure
#   (obrigatório por spec: SameSite=None exige HTTPS).

# Throttle
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Métricas (Prometheus) — GET /metrics/prometheus
# Sem METRICS_TOKEN o endpoint fica DESABILITADO e responde 401 (fail-closed,
# o guard é um token de scrape para máquina, não um JWT de admin).
# Configure um token e envie no scrape: header `x-metrics-token: <token>`.
# Gere com: openssl rand -hex 32
# METRICS_TOKEN=<gere um segredo de 32 bytes>

# Web
NEXT_PUBLIC_API_URL=http://localhost:3000
# WEB_PORT=3001
# NEXT_PUBLIC_BRAND_NAME=Minha Escola
# NEXT_PUBLIC_BRAND_LOGO_URL=https://...

# Gitea
GITEA_URL=http://localhost:3030
# GITEA_TOKEN=<copie o valor impresso por pnpm seed:gitea>
# GITEA_WEBHOOK_SECRET=<gere com: openssl rand -hex 32>
GITEA_ENABLED=true
# GITEA_HTTP_PORT=3030
# GITEA_SSH_PORT=2222

# Sandbox (Piston) — usado pela API quando roda fora do compose
# PISTON_URL=http://localhost:2000
# PISTON_TIMEOUT_MS=30000
# PISTON_MAX_OUTPUT_CHARS=4096

# Seed do Gitea (usado por scripts/seed-gitea.mjs)
# ⚠️  NUNCA use estas senhas em produção ou em ambientes expostos.
GITEA_ADMIN_USER=admin
GITEA_ADMIN_PASSWORD=admin12345
GITEA_ADMIN_EMAIL=admin@plataforma.local
GITEA_ORG=plataforma
GITEA_BOT_USER=plataforma-bot
GITEA_BOT_PASSWORD=bot12345
GITEA_BOT_EMAIL=plataforma-bot@plataforma.local

# Prisma (migrations)
SHADOW_DATABASE_URL=postgresql://plataforma:plataforma_dev@localhost:5432/plataforma_shadow

# =============================================================================
# AI Tutor — camada de provedor agnóstica (Sprint 22)
# =============================================================================
# A tutora funciona com QUALQUER provedor, escolhido só por configuração
# (nenhum código muda ao trocar). Sem provedor utilizável, ela cai na
# engine heurística local — sempre ROTULADA como "modo offline" para o
# aluno (a tutora nunca finge ser um LLM quando não é).
#
# --- Kill switch -------------------------------------------------------------
# AI_TUTOR_ENABLED=false
#   Desliga o LLM por completo (a tutora responde pela heurística
#   rotulada). Valores aceitos p/ desligar: false | 0 | off.
#
# --- Provedor ----------------------------------------------------------------
# AI_PROVIDER=gemini
#   gemini | openai (=openai-compatible) | none.
#   Sem AI_PROVIDER: AI_API_URL definida ⇒ openai-compatible (ambiente
#   legado); senão, gemini.
# AI_TIMEOUT_MS=30000
#   Timeout (ms) de cada chamada ao LLM; default 30000. Vale para
#   requisições normais e como idle-timeout no streaming.
#
# --- Caminho 1: Gemini (API do Google) ---------------------------------------
# AI_GEMINI_API_KEY=
#   Chave do Google AI Studio (header x-goog-api-key). Sem esta var,
#   AI_API_KEY é usada como chave do Gemini.
# AI_GEMINI_MODEL=gemini-3.5-flash-lite
#   Default PROVADO em produção (2026-10-22). Tier de qualidade:
#   gemini-3.5-flash. NÃO use as famílias 2.0 (desligada pelo Google) ou
#   2.5 (a geração retorna 404 "no longer available to new users" mesmo
#   com o modelo listado na conta).
# AI_GEMINI_THINKING_BUDGET=128
#   Teto de "thought tokens" por chamada: modelos Gemini 3.x raciocinam
#   por padrão e cobram por isso; 128 é enxuto p/ dicas curtas.
#   Use "dynamic" para deixar o modelo decidir.
# AI_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
#
# --- Caminho 2: OpenAI-compatível remoto (OpenAI e compatíveis) --------------
# AI_OPENAI_BASE_URL=https://api.openai.com/v1
#   A URL de chat é <base>/chat/completions.
# AI_OPENAI_API_KEY=
# AI_OPENAI_MODEL=gpt-4o-mini
#
# --- Caminho 3: modelo LOCAL (Ollama / LM Studio) -----------------------------
# Ollama (http://localhost:11434) e LM Studio (http://localhost:1234)
# expõem endpoints OpenAI-compatíveis — sem chave:
# AI_PROVIDER=openai
# AI_OPENAI_BASE_URL=http://localhost:11434/v1
# AI_OPENAI_MODEL=llama3.1
#
# --- Cota diária por aluno (proteção de custo) -------------------------------
# AI_DAILY_QUOTA_FREE=20
# AI_DAILY_QUOTA_PRO=200
#   Chamadas ao LLM por aluno/dia (UTC), por plano. Estourar a cota NÃO
#   dá erro ao aluno: a tutora degrada para a heurística rotulada.
#   20/200 são os defaults CONFIRMADOS pelo Augusto (decisão Q5,
#   2026-10-23). Contagem via Redis; sem Redis, a cota é fail-open
#   (a tutora não cai por falha do contador). O uso (tokens, latência,
#   thought tokens, resultado) é registrado no evento `ai_llm_usage`
#   de analytics_events.
#
# --- Legado (ainda honrado como fallback das vars acima) ---------------------
# AI_API_KEY=<sua chave>
#   Chave genérica: vale p/ o provedor resolvido (Gemini ou
#   OpenAI-compatível) quando a var específica dele não está definida.
# AI_API_URL=https://api.openai.com/v1/chat/completions
#   URL COMPLETA de chat/completions (OpenAI-compatível). Se definida
#   sem AI_PROVIDER, seleciona o caminho OpenAI-compatível.
# AI_MODEL=gpt-4o-mini
#   Modelo genérico: vale p/ o provedor resolvido quando a var
#   específica dele (AI_GEMINI_MODEL/AI_OPENAI_MODEL) não está definida.
#
# --- Golden set contra o provedor real (gate sob demanda) --------------------
# Roda os 16 casos do golden set contra o provedor configurado acima
# (a suíte normal usa o modo mockado/offline). A partir de apps/api:
#   GOLDEN_LIVE=1 npx jest src/ai/golden/golden-live.spec.ts
# Reprova se: qualquer caso cair na heurística, tier divergir, ou
# houver spoiler (stderr de teste oculto, linha da solução de
# referência, bloco de código > 3 linhas úteis).
