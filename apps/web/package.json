{
  "name": "@plataforma/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node -r ./set-env.js ./node_modules/next/dist/bin/next dev -p 3001 -H 0.0.0.0",
    "build": "node --max-old-space-size=4096 -r ./set-env.js ./node_modules/next/dist/bin/next build",
    "start": "node -r ./set-env.js ./node_modules/next/dist/bin/next start -p 3001 -H 0.0.0.0",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@codesandbox/sandpack-react": "^2.20.0",
    "@gsap/react": "^2.1.2",
    "@monaco-editor/react": "^4.7.0",
    "@plataforma/contracts": "workspace:*",
    "@tanstack/react-query": "^5.107.1",
    "gsap": "^3.15.1",
    "next": "^16.4.6",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "autoprefixer": "^10.5.5",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.5.0",
    "vitest": "^5.0.1"
  }
}
