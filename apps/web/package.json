{
  "name": "@plataforma/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node -r ./set-env.js ./node_modules/next/dist/bin/next dev -p 3001 -H 0.0.0.0",
    "build": "node --max-old-space-size=4096 -r ./set-env.js ./node_modules/next/dist/bin/next build",
    "start": "node -r ./set-env.js ./node_modules/next/dist/bin/next start -p 3001 -H 0.0.0.0",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-query": "^5.102.8",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.5.5",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.5.0",
    "vitest": "^5.0.1"
  }
}
